{
  "name": "census",
  "version": "0.1.0",
  "description": "A text census of a live web page's styles, for an AI to check a design system without screenshots.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "census": "cli/census.mjs"
  },
  "main": "dist/census.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cli",
    "prompt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/browser.ts --bundle --format=iife --outfile=dist/census.js --log-level=warning && esbuild src/index.ts --bundle --format=esm --outfile=dist/census.mjs --log-level=warning && tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node test/census-test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "svelte": "^5.57.3",
    "typescript": "5.6.3",
    "vue": "3.5"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}

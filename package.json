{
  "name": "@leonidstern/census",
  "version": "0.4.0",
  "description": "Eyes for a blind agent: a live web page's styles as text an AI can check, by your design system's own words.",
  "keywords": [
    "design-system",
    "visual-regression",
    "accessibility",
    "wcag",
    "css",
    "agent",
    "llm",
    "playwright",
    "ci"
  ],
  "homepage": "https://github.com/LeonidStern/census#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonidStern/census.git"
  },
  "bugs": {
    "url": "https://github.com/LeonidStern/census/issues"
  },
  "author": "Leonid Stern",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "census": "cli/census.mjs"
  },
  "main": "dist/census.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/browser.ts --bundle --format=iife --outfile=dist/census.js --log-level=warning && esbuild src/index.ts --bundle --format=esm --outfile=dist/census.mjs --log-level=warning && tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node test/census-test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "svelte": "^5.57.3",
    "typescript": "5.6.3",
    "vue": "3.5"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/census.mjs"
    },
    "./playwright": "./cli/playwright.mjs",
    "./census.js": "./dist/census.js",
    "./package.json": "./package.json"
  }
}
